COOKIE_SECURE=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Göreli yollar backend klasörüne göre çözülür.
DATA_FILE=data/campus.json
# Optional backend-only LLM assistant. Missing key does not block optimization.
# Never use VITE_ for keys. Restart the backend after configuration changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
